<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MigraineTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Основные цвета для ночной темы -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Цвета поверхности для ночной темы -->
        <item name="colorSurface">@color/background_card</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:colorBackground">@color/background_main</item>
        <item name="colorOnBackground">@color/white</item>

        <!-- Статус бар для ночной темы -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Диалоги для ночной темы -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog</item>

        <!-- Цвета для кнопок в ночной теме -->
        <item name="colorButtonNormal">?attr/colorPrimary</item>
        <item name="colorControlHighlight">?attr/colorPrimary</item>
    </style>

</resources>