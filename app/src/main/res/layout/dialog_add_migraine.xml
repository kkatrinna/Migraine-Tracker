<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Время начала:"
        android:textStyle="bold"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/edit_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="ЧЧ:ММ"
            android:inputType="number"
            android:maxLength="5"
            android:textSize="16sp"
            android:digits="0123456789" />

        <Button
            android:id="@+id/button_current_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сейчас"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Интенсивность боли:"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <SeekBar
        android:id="@+id/seekBar_intensity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="10"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/text_intensity_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0/10"
        android:gravity="center"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginVertical="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Лекарство:"
        android:textStyle="bold"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinner_medication"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Или своё лекарство:"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/edit_medication"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Название таблетки"
        android:layout_marginTop="4dp"
        android:inputType="text" />

</LinearLayout>